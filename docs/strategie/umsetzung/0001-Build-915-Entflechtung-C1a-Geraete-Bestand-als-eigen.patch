+    # ── 4. Neues main.py ────────────────────────────────────────────────────
+    behalten_text = "".join(
+        "".join(zeilen[a - 1:b]) + "\n" for a, b, _ in BLEIBEN
+    )
+    ersatz = (
+        "# ── Geraete-Bestand: geteilte Helfer ────────────────────────────────────\n"
+        "# Die Routen des Bestand-Moduls liegen seit Welle C1a in\n"
+        "# backend/geraetebestand_router.py. Diese Helfer bleiben hier, weil main.py\n"
+        "# sie an geraete_verwaltung und geraete_ersatzteile weiterreicht.\n\n"
+        + behalten_text
