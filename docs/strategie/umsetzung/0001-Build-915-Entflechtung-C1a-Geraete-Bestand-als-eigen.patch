+# -*- coding: utf-8 -*-
+"""Geraete-Bestand (Materialfahrer-Workflow) — aus main.py herausgeloest (Welle C1a).
+
+Greift auf dieselbe Tabelle wie die DGUV V3-App zu (`dguv3_geraete`), damit
+Standort-Aenderungen automatisch beim DGUV-Pruefer auftauchen.
+Berechtigung: materialfahrer + objektleitung + bereichsleitung + GF + admin.
+Verschrottung: Foto-Pflicht ausser fuer techdienst_lager.
+Standort/Status/Historie: ein Schreibweg ueber `geraete_standort` (RPC + Trigger).
+
+WAS SICH GEGENUEBER main.py GEAENDERT HAT — UND WAS NICHT
+----------------------------------------------------------
+Geaendert: nur die Dekoratoren (`@app.x("/api/...")` -> `@router.x("/...")`) und
+die Einhaengung. Die Rumpftexte aller Funktionen sind byte-identisch uebernommen,
+inklusive Zugriffswaechter, Reihenfolge und Kommentaren. Kein Verhalten wurde
+angefasst — der Routen-Paritaetstest weist das nach.
+
+DREI ROUTER, WEIL DREI PRAEFIXE
+-------------------------------
+Der Block war thematisch eine Einheit, hing aber an drei URL-Praefixen. Damit die
+Pfade exakt gleich bleiben, bekommt jeder seinen eigenen Router:
+  * `router`            /api/geraetebestand   (13 Routen)
+  * `router_geraeteart` /api/geraeteart       (1 Route: Nacht-Agent-Lauf)
+  * `router_dguv3`      /api/dguv3            (1 Route: Objektnamen)
+
+GETEILTE HELFER BLEIBEN IN main.py
+----------------------------------
+`_ist_geraete_user`, `_geraete_tuer`, `_ist_techdienst`, `_zentrallager_id`,
+`_geraete_foto_upload` und `_norm_sn` sind NICHT mitgewandert: main.py reicht sie
+bereits an `geraete_verwaltung` und `geraete_ersatzteile` weiter, sie sind also
+geteilte Infrastruktur. Dieses Modul bekommt sie wie jedes andere Hausmodul ueber
+`init()`. Die Namen sind absichtlich dieselben wie in main.py — so mussten die
+Rumpftexte nicht angefasst werden.
+"""
+from __future__ import annotations
+
+import hmac
+import logging
+import os
+from datetime import datetime, timezone
+from typing import Optional
+
+from fastapi import APIRouter, BackgroundTasks, Header, HTTPException
+from pydantic import BaseModel, Field
+from supabase import Client
+
+import geraete_standort
+import geraete_verwaltung as _gv
+
+router = APIRouter(prefix="/api/geraetebestand", tags=["geraetebestand"])
+router_geraeteart = APIRouter(prefix="/api/geraeteart", tags=["geraetebestand"])
+router_dguv3 = APIRouter(prefix="/api/dguv3", tags=["geraetebestand"])
+
+_log = logging.getLogger("geraetebestand")
+
+
+# ── Von main.py gereichte Helfer (Hauskonvention: init() beim Start) ───────
+require_user = None
+_sb_service = None
+_profil_rollen = None
+hat_feature = None
+_geofence_objekte = None
+_haversine_m = None
+_objekte_mit_kunde = None
+_push_send_to_mitarbeiter = None
+_ist_geraete_user = None
+_geraete_tuer = None
+_ist_techdienst = None
+_zentrallager_id = None
+_geraete_foto_upload = None
+_norm_sn = None
+
+_PFLICHT = ("require_user", "sb_service", "profil_rollen", "hat_feature", "geofence_objekte", "haversine_m", "objekte_mit_kunde", "push_send_to_mitarbeiter", "ist_geraete_user", "geraete_tuer", "ist_techdienst", "zentrallager_id", "geraete_foto_upload", "norm_sn",)
+
+
+def init(**helfer):
+    """Wird in main.py einmal beim Start aufgerufen, vor include_router.
+
+    Fehlt ein Helfer, schlaegt das hier beim Start fehl — nicht erst bei der
+    ersten Anfrage mit einem NoneType-Fehler.
+    """
+    fehlt = [k for k in _PFLICHT if k not in helfer]
+    if fehlt:
+        raise RuntimeError("geraetebestand_router.init: es fehlen " + ", ".join(fehlt))
+    global require_user, _sb_service, _profil_rollen, hat_feature, _geofence_objekte, _haversine_m, _objekte_mit_kunde, _push_send_to_mitarbeiter, _ist_geraete_user, _geraete_tuer, _ist_techdienst, _zentrallager_id, _geraete_foto_upload, _norm_sn
+    require_user = helfer["require_user"]
+    _sb_service = helfer["sb_service"]
+    _profil_rollen = helfer["profil_rollen"]
+    hat_feature = helfer["hat_feature"]
+    _geofence_objekte = helfer["geofence_objekte"]
+    _haversine_m = helfer["haversine_m"]
+    _objekte_mit_kunde = helfer["objekte_mit_kunde"]
+    _push_send_to_mitarbeiter = helfer["push_send_to_mitarbeiter"]
+    _ist_geraete_user = helfer["ist_geraete_user"]
+    _geraete_tuer = helfer["geraete_tuer"]
+    _ist_techdienst = helfer["ist_techdienst"]
+    _zentrallager_id = helfer["zentrallager_id"]
+    _geraete_foto_upload = helfer["geraete_foto_upload"]
+    _norm_sn = helfer["norm_sn"]
+
+
+# ── Routen und Helfer (unveraendert aus main.py) ────────────────────────────
+
+class _GeraetBewegungBody(BaseModel):
+    nach_objekt_id: str
+    nach_unterbereich_id: Optional[str] = None  # log-269 — optional pro Bewegung
+    kommentar: Optional[str] = None
+    # Ampel (Build 744): Bei einer Warnung (Frist abgelaufen, Defekt gemeldet) nur mit
+    # Begruendung; gesperrte Geraete (Defekt bestaetigt, nicht bestanden) gar nicht.
+    begruendung: Optional[str] = None
+    foto_base64: Optional[str] = None
+    foto_mime: Optional[str] = "image/jpeg"
+
+
+class _GeraetEinlagerungBody(BaseModel):
+    kommentar: Optional[str] = None
+    foto_base64: Optional[str] = None
+    foto_mime: Optional[str] = "image/jpeg"
+
+
+class _GeraetVerschrottungBody(BaseModel):
+    grund: str = Field(min_length=2)
+    foto_base64: Optional[str] = None
+    foto_mime: Optional[str] = "image/jpeg"
+
+
+
+
+@router.get("/scan")
+def geraetebestand_scan(
+    code: str,
+    authorization: Optional[str] = Header(None),
+):
+    """Findet ein Geraet per Seriennummer oder Inventar-Nummer (QR-Scan-Inhalt)."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung fuer das Geraete-Modul")
+    code = (code or "").strip()
+    if not code:
+        raise HTTPException(400, "Code/Seriennummer fehlt")
+    sr = _sb_service()
+    res = (
+        sr.table("dguv3_geraete")
+        .select("*,objekt:objekte(id,bezeichnung,strasse,plz,ort)")
+        .or_(f"seriennummer.eq.{code},inventar_nr.eq.{code}")
+        .limit(1)
+        .execute()
+    )
+    if res.data:
+        return {"ok": True, "gefunden": True, "geraet": res.data[0]}
+    # Robuster Fallback: normalisiert + Teiltreffer (fängt Leerzeichen/Format/„… test"-Reste)
+    m = _geraet_match_seriennummer(sr, [code])
+    if m:
+        return {"ok": True, "gefunden": True, "geraet": m["geraet"]}
+    return {"ok": False, "gefunden": False, "code": code}
+
+
+def _dguv3_status(pruef: Optional[dict]) -> dict:
+    """DGUV-V3-Status aus der NEUESTEN Prüfung (oder None) — Ampel + Klartext für die Anzeige."""
+    base = {"ampel": "nie", "label": "noch nie geprüft", "letzte_pruefung": None,
+            "naechste_pruefung": None, "ergebnis": None, "maengel": None,
+            "protokoll_foto_path": None, "tage_bis_faellig": None}
+    if not pruef:
+        return base
+    erg = pruef.get("ergebnis")
+    naechste = pruef.get("naechste_pruefung_am")
+    tage = None
+    ampel = "gueltig"
+    if naechste:
+        try:
+            d = datetime.fromisoformat(str(naechste)).date()
+            tage = (d - datetime.now(timezone.utc).date()).days
+            ampel = "ueberfaellig" if tage < 0 else ("faellig_bald" if tage <= 30 else "gueltig")
+        except ValueError:
+            ampel = "gueltig"
+    if erg == "nicht_bestanden":
+        ampel = "ueberfaellig"   # nicht bestanden → immer rot, unabhängig vom Datum
+    labels = {"gueltig": "geprüft & gültig", "faellig_bald": "Prüfung fällig bald",
+              "ueberfaellig": "überfällig / nicht bestanden"}
+    return {"ampel": ampel, "label": labels.get(ampel, "noch nie geprüft"),
+            "letzte_pruefung": pruef.get("pruef_datum"), "naechste_pruefung": naechste,
+            "ergebnis": erg, "maengel": pruef.get("maengel_text"),
+            "protokoll_foto_path": pruef.get("protokoll_foto_path"), "tage_bis_faellig": tage}
+
+
+def _dguv3_letzte_pruefung(sr, geraet_id: str) -> Optional[dict]:
+    r = (sr.table("dguv3_pruefungen")
+         .select("pruef_datum,naechste_pruefung_am,ergebnis,maengel_text,protokoll_foto_path")
+         .eq("geraet_id", geraet_id).order("pruef_datum", desc=True).limit(1).execute())
+    return (r.data or [None])[0]
+
+
+
+
+def _geraet_match_seriennummer(sr, codes: list) -> Optional[dict]:
+    """Findet ein Gerät robust per Seriennummer/Inventar-Nr.: normalisiert + Teiltreffer,
+    gegen alle übergebenen Kandidaten. Liefert {code, geraet, dguv3} oder None."""
+    cand, seen = [], set()
+    for c in codes or []:
+        n = _norm_sn(c)
+        if len(n) >= 4 and n not in seen:
+            seen.add(n)
+            cand.append((n, (c or "").strip()))
+    if not cand:
+        return None
+    alle = (sr.table("dguv3_geraete")
+            .select("*,objekt:objekte(id,bezeichnung,strasse,plz,ort)").execute().data or [])
+    for exact in (True, False):   # erst exakt-normalisiert, dann Teiltreffer
+        for g in alle:
+            for fld in (g.get("seriennummer"), g.get("inventar_nr")):
+                ng = _norm_sn(fld)
+                if not ng:
+                    continue
+                for cn, craw in cand:
+                    hit = (cn == ng) if exact else (len(cn) >= 5 and (cn in ng or ng in cn))
+                    if hit:
+                        return {"code": craw, "geraet": g,
+                                "dguv3": _dguv3_status(_dguv3_letzte_pruefung(sr, g["id"]))}
+    return None
+
+
+def _service_historie(sr, g: dict) -> dict:
+    """Aggregiert Service-Bot-Reparaturen (service_protokolle) zu EINEM Gerät:
+    - exakt: per geraet_id ODER normalisierter Seriennummer
+    - Modell-Fallback: gleicher Hersteller + Modell im geraet-Text (wenn keine exakten Treffer)
+    Liefert Anzahl, Defektart-Verteilung, letzte 5 Einträge — OHNE Technikernamen (Datenminimierung)."""
+    gid = g.get("id")
+    snnorm = _norm_sn(g.get("seriennummer"))
+    hers = (g.get("hersteller") or "").strip()
+    modell_norm = _norm_sn(g.get("modell"))
+    try:
+        q = sr.table("service_protokolle").select(
+            "id,datum,defekt,defektart,tags,geraet,hersteller,seriennummer_norm,geraet_id")
+        if hers:
+            res = q.or_(f"geraet_id.eq.{gid},hersteller.ilike.%{hers}%").order("datum", desc=True).limit(500).execute()
+        else:
+            res = q.eq("geraet_id", gid).order("datum", desc=True).limit(500).execute()
+        rows = res.data or []
+    except Exception as e:  # noqa: BLE001 — Anzeige darf das Detail nie sprengen
+        _log.warning("service_historie fehlgeschlagen: %s", e)
+        return {"anzahl": 0, "ebene": "keine", "verteilung": [], "eintraege": [], "warnung": False}
+
+    exakt, modellt = [], []
+    for r in rows:
+        if r.get("geraet_id") == gid or (snnorm and r.get("seriennummer_norm") == snnorm):
+            exakt.append(r)
+        elif (hers and (r.get("hersteller") or "").strip().lower() == hers.lower()
+              and modell_norm and modell_norm in _norm_sn(r.get("geraet"))):
+            modellt.append(r)
+    treffer = exakt if exakt else modellt
+    ebene = "geraet" if exakt else ("modell" if modellt else "keine")
+
+    vert = {}
+    for r in treffer:
+        a = r.get("defektart") or "Sonstiges"
+        vert[a] = vert.get(a, 0) + 1
+    verteilung = sorted(({"art": k, "n": v} for k, v in vert.items()), key=lambda x: -x["n"])
+    eintraege = [{"datum": r.get("datum"), "defekt": (r.get("defekt") or "")[:140],
+                  "defektart": r.get("defektart"), "tags": (r.get("tags") or [])[:6]}
+                 for r in treffer[:5]]
+    return {"anzahl": len(treffer), "ebene": ebene, "verteilung": verteilung,
+            "eintraege": eintraege, "warnung": len(treffer) >= 3}
+
+
+def _typenschild_nummern(erkannt: dict) -> list:
+    """Sammelt ALLE nummern-artigen Tokens aus dem OCR-Ergebnis (Seriennummer, Kandidaten,
+    weitere Angaben, Modell) als robusten Suchpool — falls die KI die echte Seriennummer
+    falsch einsortiert (z. B. als 'Art-Nr.' im Freitext). Reihenfolge = Priorität."""
+    import re as _re
+    pool, seen = [], set()
+
+    def add(tok):
+        tok = (tok or "").strip()
+        n = _norm_sn(tok)
+        if len(n) >= 4 and any(c.isdigit() for c in n) and n not in seen:
+            seen.add(n)
+            pool.append(tok)
+
+    add(erkannt.get("seriennummer"))
+    for k in (erkannt.get("seriennummer_kandidaten") or []):
+        add(k)
+    blob = " ".join(str(erkannt.get(f) or "") for f in ("weitere_angaben", "modell"))
+    for tok in _re.findall(r"[A-Za-z]*\d[\w./\-]*", blob):
+        add(tok)
+    return pool
+
+
+class _TypenschildBody(BaseModel):
+    image_b64: str
+    mime_type: Optional[str] = "image/jpeg"
+
+
+@router.post("/typenschild")
+async def geraetebestand_typenschild(body: _TypenschildBody, authorization: Optional[str] = Header(None)):
+    """Liest ein Geräte-Typenschild per KI-Vision (Vertex Gemini, EU) → Stammdaten-Vorschlag
+    (Seriennummer, Hersteller, Modell, Geräteart, Baujahr, weitere Angaben). Sucht zugleich,
+    ob die erkannte Seriennummer bereits existiert (Suche/Dubletten-Schutz). Mensch bestätigt."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung für das Geräte-Modul")
+    if not (body.image_b64 or "").strip():
+        raise HTTPException(400, "Kein Bild übergeben")
+    import vertex_gemini
+    try:
+        erkannt = await vertex_gemini.lies_typenschild_async(body.image_b64, body.mime_type or "image/jpeg")
+    except Exception as e:
+        _log.error("typenschild ocr failed: %s", e)
+        raise HTTPException(502, f"Typenschild-Erkennung fehlgeschlagen. {vertex_gemini.fehler_text(e)}")
+    # ALLE erkannten Nummern gegen den Bestand prüfen (Suche / Dubletten-Schutz)
+    sr = _sb_service()
+    nummern = _typenschild_nummern(erkannt)
+    treffer = _geraet_match_seriennummer(sr, nummern)
+    return {"ok": True, "erkannt": erkannt, "gefunden": bool(treffer),
+            "treffer": treffer, "nummern": nummern}
+
+
+@router.get("/geraet/{geraet_id}")
+def geraetebestand_detail(geraet_id: str, authorization: Optional[str] = Header(None)):
+    """Detail mit Stamm + aktuellem Objekt + Bewegungs-Historie + DGUV-V3-Status."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    g = (
+        sr.table("dguv3_geraete")
+        .select("*,objekt:objekte(id,bezeichnung,strasse,plz,ort)")
+        .eq("id", geraet_id)
+        .limit(1)
+        .execute()
+    )
+    if not g.data:
+        raise HTTPException(404, "Geraet nicht gefunden")
+    dguv3 = _dguv3_status(_dguv3_letzte_pruefung(sr, geraet_id))
+    bew = (
+        sr.table("dguv3_geraete_bewegungen")
+        .select("id,typ,von_objekt_id,nach_objekt_id,durchgefuehrt_von_id,foto_storage_pfad,kommentar,erstellt_am,"
+                "von:objekte!von_objekt_id(id,bezeichnung),"
+                "nach:objekte!nach_objekt_id(id,bezeichnung)")
+        .eq("geraet_id", geraet_id)
+        .order("erstellt_am", desc=True)
+        .execute()
+    )
+    rows = bew.data or []
+    ma_ids = sorted({r["durchgefuehrt_von_id"] for r in rows if r.get("durchgefuehrt_von_id")})
+    ma_map = {}
+    if ma_ids:
+        m = sr.table("ma_mitarbeiter").select("id,vorname,nachname").in_("id", ma_ids).execute()
+        ma_map = {x["id"]: x for x in (m.data or [])}
+    for r in rows:
+        mp = ma_map.get(r.get("durchgefuehrt_von_id"))
+        r["durchgefuehrt_von_name"] = f"{mp.get('vorname','')} {mp.get('nachname','')}".strip() if mp else None
+    service = _service_historie(sr, g.data[0])
+    # Build 744: Zustand/Ampel + Ereignisse (Zustandswechsel, Ausgaben, Freigaben trotz Warnung)
+    ampel = _gv.ampel(sr, "dguv3", g.data[0])
+    ereignisse = (sr.table("geraet_ereignis").select("art,von,nach,grund,erstellt_am")
+                  .eq("geraet_id", geraet_id).order("erstellt_am", desc=True).limit(50).execute().data or [])
+    ausgabe = _gv._offene_ausgabe(sr, "dguv3", geraet_id)
+    return {"ok": True, "geraet": g.data[0], "historie": rows, "dguv3": dguv3, "service": service,
+            "ampel": ampel, "ereignisse": ereignisse, "ausgabe": ausgabe,
+            "darf_sperre_aufheben": _ist_techdienst(u["profil"]),
