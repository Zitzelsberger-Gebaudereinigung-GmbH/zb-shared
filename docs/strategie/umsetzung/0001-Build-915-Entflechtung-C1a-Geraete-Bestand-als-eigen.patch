+
+    if probe:
+        print("[c1a] --probe: nichts geschrieben")
+        return fehler
+
+    ZIEL.write_text(modul, encoding="utf-8")
+    MAIN.write_text(neu_main, encoding="utf-8")
+    print(f"[c1a] geschrieben: {ZIEL.name} ({len(modul.splitlines())} Zeilen), "
