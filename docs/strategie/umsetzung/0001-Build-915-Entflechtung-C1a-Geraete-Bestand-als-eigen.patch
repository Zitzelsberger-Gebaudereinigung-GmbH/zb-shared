+def geraetebestand_uebersicht(
+    objekt_id: Optional[str] = None,
+    authorization: Optional[str] = Header(None),
+):
+    """Aggregat-Sicht: Anzahl pro Status + Geraete-Liste.
+    Mit optionalem objekt_id-Filter werden nur Geraete dieses Objekts angezeigt
+    (auch das Zentrallager kann gefiltert werden, um den Pool-Bestand zu sehen)."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    q = sr.table("dguv3_geraete").select(
+        "id,seriennummer,inventar_nr,geraetetyp,hersteller,modell,objekt_id,pool_status,aktiv,zustand,"
+        "lagerklasse,ruhend_seit,ruhend_grund,hersteller_nachweis,pruef_intervall_monate,"
+        "objekt:objekte(id,bezeichnung)"
+    )
+    objekt_meta = None
+    if objekt_id:
+        q = q.eq("objekt_id", objekt_id)
+        obj_res = sr.table("objekte").select("id,bezeichnung,strasse,plz,ort").eq("id", objekt_id).limit(1).execute()
+        objekt_meta = (obj_res.data or [None])[0]
+    res = q.order("seriennummer").execute()
+    geraete = res.data or []
+    aggregat = {"im_einsatz": 0, "pool": 0, "verschrottet": 0, "pool_reserve": 0, "pool_ruhend": 0}
+    for g in geraete:
+        s = g.get("pool_status") or "im_einsatz"
+        aggregat[s] = aggregat.get(s, 0) + 1
+        ls = _gv.lagerstatus(g)          # Build 893: Reserve und Sammelbestand getrennt ausweisen (R13)
+        if ls in ("pool_reserve", "pool_ruhend"):
+            aggregat[ls] += 1
+        g["lagerstatus"] = ls
+    # DGUV-V3-Ampel je Gerät (neueste Prüfung) — für die Listen-Ansicht
+    ids = [g["id"] for g in geraete if g.get("id")]
+    pruef_map = {}
+    if ids:
+        pr = (sr.table("dguv3_pruefungen")
+              .select("geraet_id,pruef_datum,naechste_pruefung_am,ergebnis")
+              .in_("geraet_id", ids).order("pruef_datum", desc=True).execute().data or [])
+        for p in pr:
+            gid = p.get("geraet_id")
+            if gid and gid not in pruef_map:   # erste = neueste (desc)
+                pruef_map[gid] = p
+    dguv3_aggregat = {"gueltig": 0, "faellig_bald": 0, "ueberfaellig": 0, "nie": 0}
+    for g in geraete:
+        st = _dguv3_status(pruef_map.get(g["id"]))
+        g["dguv3_ampel"] = st["ampel"]
+        g["dguv3_naechste"] = st["naechste_pruefung"]
+        g["ampel"] = _gv.ampel(sr, "dguv3", g, pruef_map.get(g["id"]), pruefung_geladen=True)["farbe"]
+        if (g.get("pool_status") or "im_einsatz") != "verschrottet":
+            dguv3_aggregat[st["ampel"]] = dguv3_aggregat.get(st["ampel"], 0) + 1
+    return {"ok": True, "geraete": geraete, "aggregat": aggregat,
+            "dguv3_aggregat": dguv3_aggregat, "objekt": objekt_meta}
+
+
+@router.get("/foto-url")
+def geraetebestand_foto_url(pfad: str, authorization: Optional[str] = Header(None)):
+    """Signed-URL fuer ein Geraete-Foto."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    try:
+        signed = sr.storage.from_("geraete-fotos").create_signed_url(pfad, 3600)
+        return {"url": signed.get("signedURL") or signed.get("signed_url")}
+    except Exception as e:
+        raise HTTPException(500, f"Signed-URL fehlgeschlagen: {e}")
