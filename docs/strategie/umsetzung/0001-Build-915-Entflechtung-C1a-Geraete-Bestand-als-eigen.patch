+@router.post("/{geraet_id}/bewegen")
+def geraetebestand_bewegen(
+    geraet_id: str,
+    body: _GeraetBewegungBody,
+    background_tasks: BackgroundTasks,
+    authorization: Optional[str] = Header(None),
+):
+    """Dokumentiert einen Standortwechsel (Objekt → Objekt). Standardfall des Materialfahrers."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    g = sr.table("dguv3_geraete").select("id,objekt_id,pool_status,aktiv,geraetetyp,seriennummer").eq("id", geraet_id).limit(1).execute()
+    if not g.data:
+        raise HTTPException(404, "Geraet nicht gefunden")
+    if g.data[0].get("pool_status") == "verschrottet":
+        raise HTTPException(409, "Geraet ist verschrottet — kein Vorgang moeglich")
+    if not g.data[0].get("aktiv"):
+        raise HTTPException(409, "Geraet ist nicht aktiv")
+    von_id = g.data[0].get("objekt_id")
+    nach_id = body.nach_objekt_id
+    if von_id == nach_id:
+        raise HTTPException(409, "Geraet steht bereits in diesem Objekt")
+    zentral_id = _zentrallager_id(sr)
+    if nach_id == zentral_id:
+        raise HTTPException(400, "Fuer das Zentrallager bitte die Aktion 'Einlagern' nutzen")
+    if _gv._offene_ausgabe(sr, "dguv3", geraet_id):
+        raise HTTPException(409, "Das Gerät ist gerade ausgegeben (Sonderreinigung/Fahrzeug). "
+                                 "Bitte erst zurücknehmen, dann umsetzen.")
+    # Kaputt bleibt im Lager: Ampel vor dem Umsetzen (Einlagern bleibt immer frei).
+    _gv.freigabe_pruefen(sr, "dguv3", geraet_id, begruendung=body.begruendung,
+                         akteur_id=u["profil"]["id"], aktion="umsetzen")
+
+    foto_pfad = None
+    if body.foto_base64:
+        foto_pfad = _geraete_foto_upload(sr, geraet_id, body.foto_base64, body.foto_mime or "image/jpeg")
+
+    # Standort, Status und Historie in EINER Transaktion (RPC + Trigger, Migration
+    # 2026-10-15_geraete_standort_sync). Der Unterbereich wird beim Objektwechsel
+    # immer neu gesetzt (NULL oder der mitgegebene), pool_status leitet die
+    # Datenbank aus dem Standort ab, die Bewegung (lieferung/umzug) schreibt sie selbst.
+    erg = geraete_standort.standort_setzen(
+        sr, geraet_id, nach_id, kommentar=body.kommentar,
+        akteur_id=u["profil"]["id"], foto_pfad=foto_pfad,
+        unterbereich_id=body.nach_unterbereich_id)
+    typ = erg.get("typ") or ("lieferung" if von_id == zentral_id else "umzug")
+
+    # Push-Notification an den OL des Ziel-Objekts (best-effort, blockiert nicht).
+    # log-270: Wenn ein Materialfahrer ein Geraet umsetzt, sollte der OL es wissen,
+    # weil er sonst nicht prueft ob das Geraet im Inventar ist.
+    try:
+        ziel_obj = sr.table("objekte").select("bezeichnung,objektleiter_id").eq("id", nach_id).limit(1).execute()
+        if ziel_obj.data and ziel_obj.data[0].get("objektleiter_id"):
+            ol_id = ziel_obj.data[0]["objektleiter_id"]
+            ziel_name = ziel_obj.data[0].get("bezeichnung") or "neues Objekt"
+            geraet_label = g.data[0].get("geraetetyp") or g.data[0].get("seriennummer") or "Geraet"
+            push_title = "📦 Neues Geraet im Objekt"
+            push_body = f"{geraet_label} ist seit {datetime.now().strftime('%d.%m.')} in {ziel_name}."
+            _push_send_to_mitarbeiter(
+                ol_id, push_title, push_body,
+                url=f"/app.html#geraet/{geraet_id}",
+            )
+    except Exception:
+        _log.exception("Geraete-Bewegen Push-Notification fehlgeschlagen (ignoriert)")
+
+    # Neu am Objekt: Geraeteart sicherstellen, damit die allgemeine
+    # Betriebsanweisung sofort im Kundenportal steht ([d-826]).
+    background_tasks.add_task(_geraeteart_agent_hintergrund([geraet_id]))
+    return {"ok": True, "typ": typ, "nach_objekt_id": nach_id}
+
