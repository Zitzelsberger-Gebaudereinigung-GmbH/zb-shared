+    authorization: Optional[str] = Header(None),
+):
+    """Verschrottet das Geraet (irreversibel).
+    Foto-Pflicht ausser fuer techdienst_lager + Admin (Wartung/Reparatur)."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
