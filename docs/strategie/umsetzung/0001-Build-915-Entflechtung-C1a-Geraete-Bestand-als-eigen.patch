+class _GeraetStammBody(BaseModel):
+    geraetetyp: Optional[str] = None
+    hersteller: Optional[str] = None
+    modell: Optional[str] = None
+    seriennummer: Optional[str] = None
+    inventar_nr: Optional[str] = None
+    baujahr: Optional[int] = None
+    pruef_intervall_monate: Optional[int] = None
+    bemerkung: Optional[str] = None
+    # Geraeteart fuer die Kundenansicht ([d-826]). Gesetzt = von Hand gewaehlt;
+    # leer gelassen = der Geraeteart-Agent entscheidet.
+    geraeteart_id: Optional[str] = None
+
+
+def _geraeteart_agent_hintergrund(geraet_ids: list):
+    """Den Geraeteart-Agenten fuer einzelne Geraete anstossen (fail-soft)."""
+    async def _los():
+        try:
+            import geraeteart_agent  # noqa: PLC0415
+            await geraeteart_agent.lauf(_sb_service(), geraet_ids=geraet_ids)
+        except Exception:  # noqa: BLE001
+            _log.exception("Geraeteart-Agent im Hintergrund fehlgeschlagen (ignoriert)")
+    return _los
+
