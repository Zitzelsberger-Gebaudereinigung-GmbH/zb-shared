+
+    # Einhaengung direkt hinter app.include_router(_gv.router)
+    anker = "app.include_router(_gv.router)\n"
+    if neu_main.count(anker) != 1:
+        raise SystemExit(f"Anker '{anker.strip()}' nicht eindeutig ({neu_main.count(anker)}x)")
+    wiring = anker + (
+        "# Geraete-Bestand (Materialfahrer-Workflow) — Welle C1a aus main.py herausgeloest\n"
+        "import geraetebestand_router as _gb\n"
+        "_gb.init(require_user=require_user, sb_service=_sb_service, profil_rollen=_profil_rollen,\n"
+        "         hat_feature=hat_feature, geofence_objekte=_geofence_objekte, haversine_m=_haversine_m,\n"
+        "         objekte_mit_kunde=_objekte_mit_kunde, push_send_to_mitarbeiter=_push_send_to_mitarbeiter,\n"
+        "         ist_geraete_user=_ist_geraete_user, geraete_tuer=_geraete_tuer,\n"
+        "         ist_techdienst=_ist_techdienst, zentrallager_id=_zentrallager_id,\n"
+        "         geraete_foto_upload=_geraete_foto_upload, norm_sn=_norm_sn)\n"
+        "app.include_router(_gb.router)\n"
+        "app.include_router(_gb.router_geraeteart)\n"
+        "app.include_router(_gb.router_dguv3)\n"
+    )
+    neu_main = neu_main.replace(anker, wiring, 1)
+
+    print(f"[c1a] {ersetzungen} Dekoratoren umgeschrieben")
+    return modul, neu_main
+
+
+def pruefe(modul: str) -> int:
+    """Kein Name im neuen Modul darf unaufgeloest bleiben."""
+    import builtins
+    t = ast.parse(modul)
+    definiert = set(dir(builtins))
+    for n in ast.walk(t):
+        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            definiert.add(n.name)
+        if isinstance(n, (ast.Import, ast.ImportFrom)):
+            for a in n.names:
+                definiert.add((a.asname or a.name).split(".")[0])
+        if isinstance(n, ast.arg):
+            definiert.add(n.arg)
+        if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Store):
+            definiert.add(n.id)
+        if isinstance(n, ast.ExceptHandler) and n.name:
+            definiert.add(n.name)
