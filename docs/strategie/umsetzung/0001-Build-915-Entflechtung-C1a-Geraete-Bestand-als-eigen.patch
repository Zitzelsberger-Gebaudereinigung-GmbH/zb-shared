+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""Erzeugt Welle C1a: loest das Geraete-Bestand-Modul aus backend/main.py heraus.
+
+Dieses Skript ist das WERKZEUG, nicht das Ergebnis. Es liest main.py, schreibt
+backend/geraetebestand_router.py und ein neues main.py. Die Rumpftexte der
+Funktionen werden byte-identisch uebernommen — geaendert werden nur die
+Dekoratoren (@app -> @router) und die Einhaengung.
+
+Warum ein Skript und nicht von Hand: 777 Zeilen mit 15 Routen, 3 URL-Praefixen
+und 14 geteilten Helfern. Von Hand entsteht dabei genau der Tippfehler, den der
+Paritaetstest nachher findet — mit Skript gar nicht erst.
+
+Aufruf (im Repo-Wurzelverzeichnis):
+    python werkzeug_c1a_geraetebestand.py            # schreibt die Dateien
+    python werkzeug_c1a_geraetebestand.py --probe    # nur pruefen, nichts schreiben
+"""
+from __future__ import annotations
+
+import ast
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+WURZEL = Path(__file__).resolve().parent
+MAIN = WURZEL / "backend" / "main.py"
+ZIEL = WURZEL / "backend" / "geraetebestand_router.py"
+
+# Blockgrenzen, am Stand cc697dc (Build 914) ermittelt und per AST geprueft.
+BLOCK_A, BLOCK_B = 16298, 17074
+
+# Diese Helfer bleiben in main.py: main.py injiziert sie bereits in andere
+# Module (geraete_verwaltung, geraete_ersatzteile, ...) — sie sind geteilte
+# Infrastruktur, kein Teil des Bestand-Moduls. Bereiche 1-basiert, inklusiv.
+BLEIBEN = [
+    (16307, 16311, "_GERAETE_ROLLEN"),
+    (16314, 16317, "_ist_geraete_user"),
+    (16320, 16324, "_geraete_tuer"),
+    (16327, 16330, "_ist_techdienst"),
+    (16333, 16342, "_zentrallager_id"),
+    (16368, 16395, "_geraete_foto_upload"),
+    (16462, 16466, "_norm_sn"),
+]
+
+# Namen, die der Router aus main.py gereicht bekommt (Hauskonvention: init()).
+# Links der Name IM MODUL — bewusst derselbe wie in main.py, damit die
+# Rumpftexte unveraendert bleiben. Rechts der Schluessel, unter dem main.py ihn
+# reicht (ohne Unterstrich, wie bei kvp.init / _gv.init).
+INJEKTION = [
+    ("require_user", "require_user"),
+    ("_sb_service", "sb_service"),
+    ("_profil_rollen", "profil_rollen"),
+    ("hat_feature", "hat_feature"),
+    ("_geofence_objekte", "geofence_objekte"),
+    ("_haversine_m", "haversine_m"),
+    ("_objekte_mit_kunde", "objekte_mit_kunde"),
+    ("_push_send_to_mitarbeiter", "push_send_to_mitarbeiter"),
