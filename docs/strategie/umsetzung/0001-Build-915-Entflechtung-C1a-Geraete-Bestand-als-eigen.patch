+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    kand = []
+    for o in _geofence_objekte(sr):
+        d = _haversine_m(body.lat, body.lng, float(o["geocode_lat"]), float(o["geocode_lng"]))
+        kand.append((d, o))
+    kand.sort(key=lambda x: x[0])
+    if not kand:
+        return {"ok": True, "vorschlaege": [],
+                "hinweis": "Keine Objekte mit hinterlegten Koordinaten gefunden."}
+    out = [{"objekt_id": o["id"], "bezeichnung": o.get("bezeichnung"), "ort": o.get("ort"),
+            "distanz_m": round(d, 1), "im_radius": d <= (o.get("geofence_radius_m") or 150)}
+           for d, o in kand[:5]]
+    return {"ok": True, "vorschlaege": out}
