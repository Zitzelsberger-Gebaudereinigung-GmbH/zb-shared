+@router.patch("/geraet/{geraet_id}")
+def geraetebestand_update(
+    geraet_id: str,
+    body: _GeraetStammBody,
+    background_tasks: BackgroundTasks,
+    authorization: Optional[str] = Header(None),
+):
+    """Stammdaten eines Bestandsgeraets korrigieren (z. B. falsche Seriennummer).
+    Standort/Pool-Status werden NICHT hier geaendert (dafuer Bewegen/Einlagern/Verschrotten)."""
+    u = require_user(authorization)
+    if not _geraete_tuer(u["profil"]):
+        raise HTTPException(403, "Keine Berechtigung")
+    sr = _sb_service()
+    cur = (sr.table("dguv3_geraete").select("id, geraetetyp, hersteller, modell, geraeteart_id, geraeteart_quelle")
+           .eq("id", geraet_id).limit(1).execute())
+    if not cur.data:
+        raise HTTPException(404, "Geraet nicht gefunden")
+
+    def _s(v):
+        return (v.strip() or None) if isinstance(v, str) else v
+
+    geraetetyp = _s(body.geraetetyp)
+    seriennummer = _s(body.seriennummer)
+    if not geraetetyp:
+        raise HTTPException(400, "Gerätetyp darf nicht leer sein")
+    if not seriennummer:
+        raise HTTPException(400, "Seriennummer darf nicht leer sein")
+    if body.baujahr is not None and not (1900 <= int(body.baujahr) <= 2100):
+        raise HTTPException(400, "Baujahr unplausibel")
+    if body.pruef_intervall_monate is not None and not (1 <= int(body.pruef_intervall_monate) <= 120):
+        raise HTTPException(400, "Prüfintervall muss zwischen 1 und 120 Monaten liegen")
+
+    # Warnung bei doppelter Seriennummer (nur Hinweis, kein Block) — andere nicht-verschrottete Geraete
+    dup = (sr.table("dguv3_geraete").select("id")
+           .eq("seriennummer", seriennummer).neq("id", geraet_id)
+           .neq("pool_status", "verschrottet").execute().data or [])
+
+    update = {
+        "geraetetyp": geraetetyp,
+        "hersteller": _s(body.hersteller),
+        "modell": _s(body.modell),
+        "seriennummer": seriennummer,
+        "inventar_nr": _s(body.inventar_nr),
+        "baujahr": body.baujahr,
+        "pruef_intervall_monate": body.pruef_intervall_monate,
+        "bemerkung": _s(body.bemerkung),
+        "geaendert_am": datetime.now(timezone.utc).isoformat(),
+    }
+    alt = cur.data[0]
+    neu_agent = False
+    if body.geraeteart_id:
+        if not (sr.table("geraetearten").select("id").eq("id", body.geraeteart_id).limit(1).execute().data):
+            raise HTTPException(400, "Unbekannte Geräteart")
+        update |= {"geraeteart_id": body.geraeteart_id, "geraeteart_quelle": "manuell",
+                   "geraeteart_gesetzt_am": update["geaendert_am"]}
+    elif alt.get("geraeteart_quelle") != "manuell" and any(
+            (alt.get(k) or None) != update[k] for k in ("geraetetyp", "hersteller", "modell")):
+        # Typ/Hersteller/Modell geaendert: die automatische Zuordnung kann nicht
+        # mehr stimmen — neu bestimmen lassen. Eine von Hand gesetzte bleibt.
+        update |= {"geraeteart_id": None, "geraeteart_quelle": None, "geraeteart_gesetzt_am": None}
+        neu_agent = True
+    elif not alt.get("geraeteart_id"):
+        neu_agent = True
+    sr.table("dguv3_geraete").update(update).eq("id", geraet_id).execute()
+    if neu_agent:
+        background_tasks.add_task(_geraeteart_agent_hintergrund([geraet_id]))
+    return {"ok": True, "seriennummer_doppelt": bool(dup)}
+
