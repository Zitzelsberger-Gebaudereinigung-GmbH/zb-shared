+    platzhalter = "\n".join(f"{modul_name} = None" for modul_name, _ in INJEKTION)
+    pflicht = ", ".join(f'"{schluessel}"' for _, schluessel in INJEKTION)
+    zuw = "\n".join(f'    {modul_name} = helfer["{schluessel}"]' for modul_name, schluessel in INJEKTION)
+    init_text = INIT_VORLAGE.format(
+        platzhalter=platzhalter,
+        pflicht=pflicht,
