+        if pfad.startswith("/api/geraetebestand"):
+            return f'@router.{methode}("{pfad[len("/api/geraetebestand"):]}"{rest}'
+        if pfad.startswith("/api/geraeteart"):
+            return f'@router_geraeteart.{methode}("{pfad[len("/api/geraeteart"):]}"{rest}'
+        if pfad.startswith("/api/dguv3"):
